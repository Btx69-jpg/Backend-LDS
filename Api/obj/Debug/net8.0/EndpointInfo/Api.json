{
  "openapi": "3.0.1",
  "info": {
    "title": "Api",
    "version": "1.0"
  },
  "paths": {
    "/api/MatchInvite/teams/{idTeam}/match-invites": {
      "post": {
        "tags": [
          "MatchInvite"
        ],
        "parameters": [
          {
            "name": "idTeam",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMatchInviteDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMatchInviteDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SendMatchInviteDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/MatchInvite/{idTeam}/AcceptMatchInvite": {
      "post": {
        "tags": [
          "MatchInvite"
        ],
        "parameters": [
          {
            "name": "idTeam",
