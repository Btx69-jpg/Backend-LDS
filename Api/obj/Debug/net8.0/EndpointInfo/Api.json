  "components": {
    "schemas": {
      "AcceptRefusePostPoneDTO": {
        "required": [
          "idMatch",
          "idOpponent",
          "idTeam",
          "statusPostPone"
        ],
        "type": "object",
        "properties": {
          "idMatch": {
            "type": "string",
            "format": "uuid"
          },
          "statusPostPone": {
            "$ref": "#/components/schemas/StatusPostPone"
          },
          "idTeam": {
            "type": "string",
            "format": "uuid"
          },
          "idOpponent": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "CreateTeamDto": {
        "required": [
          "homePitch",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 250,
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "format": "byte",
            "nullable": true
          },
          "homePitch": {
            "$ref": "#/components/schemas/PitchDto"
          }
        },
        "additionalProperties": false
      },
      "PitchDto": {
        "required": [
          "address",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "address": {
            "maxLength": 250,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PostponeMatchDTO": {
        "required": [
          "idMatch",
          "idOpponent",
          "idTeam",
          "matchDate"
        ],
        "type": "object",
        "properties": {
          "idMatch": {
            "type": "string",
            "format": "uuid"
          },
          "matchDate": {
            "type": "string",
            "format": "date-time"
          },
          "idTeam": {
            "type": "string",
            "format": "uuid"
          },
          "idOpponent": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "SendMatchInviteDTO": {
        "required": [
          "gameDate",
          "idReceiver",
          "idSender",
          "namePitch"
        ],
        "type": "object",
        "properties": {
          "idSender": {
            "type": "string",
            "format": "uuid"
          },
          "idReceiver": {
            "type": "string",
            "format": "uuid"
          },
          "gameDate": {
            "type": "string",
            "format": "date-time"
          },
          "namePitch": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "StatusPostPone": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
